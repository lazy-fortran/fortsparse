#!/bin/sh
# Merge-queue check. The native solvers: the tests the landed
# change affects, fo test --since its base (a changed source selects its
# users, a moved dependency pin those of what changed between the pins, a
# changed build description the whole suite). The external back ends, which
# the fpm build does not cover: the ci-cmake tier of ci/run.sh through CMake.
# The runner image has no SuperLU or SuiteSparse packages, so CMake fetches
# and builds them (FORTSPARSE_USE_SYSTEM_DEPS stays off). Build trees stay
# under build/, which the runner keeps between checks.
set -eu
jobs=${CHECK_JOBS:-4}
FC=${FC:-gfortran}
export FC
export OPENBLAS_NUM_THREADS=1 OMP_DYNAMIC=FALSE OMP_WAIT_POLICY=passive
candidate=$(git rev-parse HEAD)
base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1)
if [ "$base" = "$candidate" ]; then
    base=$(git rev-parse HEAD~1)
fi

OMP_NUM_THREADS=8
export OMP_NUM_THREADS
fo build
fo test --since "$base"

OMP_NUM_THREADS=1
cmake -DFORTSPARSE_CHECK_BUILD_DIR=build/ci-cmake \
    -P cmake/fortsparse_check_compiler.cmake
cmake -S . -B build/ci-cmake -G Ninja -DCMAKE_BUILD_TYPE=Debug \
    -DFORTSPARSE_BUILD_TESTING=ON -DFORTSPARSE_ENABLE_SUPERLU=ON \
    -DFORTSPARSE_ENABLE_UMFPACK_IPC=ON
cmake --build build/ci-cmake -j "$jobs" --target test_fortsparse_status \
    test_fortsparse_solve_real test_fortsparse_solve_complex \
    test_fortsparse_solve_derivatives test_fortsparse_complex_solve_derivatives \
    test_fortsparse_superlu_symmetric test_fortsparse_errors \
    test_fortsparse_superlu_status test_fortsparse_umfpack_ipc \
    test_fortsparse_umfpack_controls fortsparse_umfpack_helper \
    test_fortsparse_precision test_fortsparse_mixed_lu test_fortsparse_stability \
    test_mixed_allocations test_fortsparse_native_general_api \
    test_fortsparse_slu_z_api test_fortsparse_ldlt_multifrontal \
    test_fortsparse_native_ldlt test_fortsparse_native_ldlt_z test_fortsparse_inertia
ctest --test-dir build/ci-cmake -j "$jobs" --output-on-failure --no-tests=error \
    -R '^test_fortsparse_(status|solve_real|solve_complex|solve_derivatives|complex_solve_derivatives|superlu_symmetric|errors|superlu_status|umfpack_ipc|umfpack_controls|precision|mixed_lu|stability|native_general_api|slu_z_api|ldlt_multifrontal|native_ldlt|native_ldlt_z|inertia)$|^test_mixed_allocations$'
