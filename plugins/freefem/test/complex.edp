load "fortsparse_native"
complex[int,int] dense=[[4.+1.i,0.,-1.+2.i],[2.-1.i,3.+.5i,0.],[0.,-2.+.25i,5.-2.i]];
matrix<complex> A=dense;
set(A,solver=sparsesolver);
complex[int] known=[1.+.5i,-2.+1.i,.5-1.i], b(3);
// RHS comes from the independent literal original matrix and known x.
b[0]=(4.+1.i)*known[0]+(-1.+2.i)*known[2];
b[1]=(2.-1.i)*known[0]+(3.+.5i)*known[1];
b[2]=(-2.+.25i)*known[1]+(5.-2.i)*known[2];
complex[int] solution=A^-1*b, error=solution-known;
assert(error.linfty<2e-12);
complex[int] residual=A*solution; residual-=b;
assert(residual.linfty<2e-12);
b=2.*b; solution=A^-1*b; error=solution-2.*known;
assert(error.linfty<4e-12);
// FreeFem prime is adjoint for complex scalars, unlike a plain transpose.
complex[int] bh(3);
bh[0]=(4.-1.i)*known[0]+(2.+1.i)*known[1];
bh[1]=(3.-.5i)*known[1]+(-2.-.25i)*known[2];
bh[2]=(-1.-2.i)*known[0]+(5.+2.i)*known[2];
solution=A'^-1*bh; error=solution-known;
assert(error.linfty<2e-12);
residual=A'*solution; residual-=bh;
assert(residual.linfty<2e-12);
A(0,0)=8.-1.i;
b[0]=(8.-1.i)*known[0]+(-1.+2.i)*known[2];
b[1]=(2.-1.i)*known[0]+(3.+.5i)*known[1];
b[2]=(-2.+.25i)*known[1]+(5.-2.i)*known[2];
solution=A^-1*b; error=solution-known;
assert(error.linfty<2e-12);
A(0,1)=1.+.25i; b[0]+=(1.+.25i)*known[1];
solution=A^-1*b; error=solution-known;
assert(error.linfty<2e-12);
residual=A*solution; residual-=b;
assert(residual.linfty<2e-12);
// Read an explicit SDK half=1 lower triangle; a literal full matrix action
// independently checks that UnHalf restores conjugate upper entries.
ifstream halfData("hermitian-half.txt");
matrix<complex> H;
halfData >> H;
set(H,solver=sparsesolver);
b[0]=4.*known[0]+(1.+2.i)*known[1];
b[1]=(1.-2.i)*known[0]+5.*known[1]+(2.+.5i)*known[2];
b[2]=(2.-.5i)*known[1]+6.*known[2];
solution=H^-1*b; error=solution-known;
assert(error.linfty<2e-12);
cout << "PASS FREEFEM NATIVE COMPLEX N/H REUSE/UPDATE/HALF/RESIDUAL" << endl;
