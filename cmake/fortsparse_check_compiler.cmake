if(NOT DEFINED FORTSPARSE_CHECK_BUILD_DIR OR FORTSPARSE_CHECK_BUILD_DIR STREQUAL "")
    message(FATAL_ERROR "FORTSPARSE_CHECK_BUILD_DIR is required")
endif()
get_filename_component(_build "${FORTSPARSE_CHECK_BUILD_DIR}" ABSOLUTE)
set(_compiler "$ENV{FC}")
if(_compiler STREQUAL "")
    set(_compiler gfortran)
endif()
separate_arguments(_compiler UNIX_COMMAND "${_compiler}")
list(POP_FRONT _compiler _command)
find_program(_compiler_path NAMES "${_command}" REQUIRED NO_CACHE)
file(SHA256 "${_compiler_path}" _compiler_hash)
execute_process(COMMAND "${_compiler_path}" ${_compiler} --version
    RESULT_VARIABLE _version_result OUTPUT_VARIABLE _version ERROR_VARIABLE _version_error
    TIMEOUT 10 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE)
if(NOT _version_result STREQUAL "0")
    message(FATAL_ERROR "Fortran compiler version query failed: ${_version_result} ${_version_error}")
endif()
string(SHA256 _signature
    "${_compiler_path};${_compiler};${_compiler_hash};${_version};${_version_error}")
set(_record "${_build}/.fortsparse-check-compiler")
set(_previous "")
if(EXISTS "${_record}")
    file(READ "${_record}" _previous)
endif()
# CMake's automatic compiler reset can retain a failed probe or lose options.
if(NOT _previous STREQUAL _signature)
    file(REMOVE_RECURSE "${_build}")
endif()
file(MAKE_DIRECTORY "${_build}")
file(WRITE "${_record}" "${_signature}")
